---
import '../styles/global.css';
import Search from 'astro-pagefind/components/Search.astro';
import RecentSearches from '../components/RecentSearches.astro';

interface Props {
  title: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Fallout 76 Helper</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header-top">
				<a class="brand" href={import.meta.env.BASE_URL}>Fallout 76 Helper</a>
				<nav>
					<a href={`${import.meta.env.BASE_URL}faq/`}>FAQ</a>
					<a href={`${import.meta.env.BASE_URL}reference/`}>Reference</a>
					<a href={`${import.meta.env.BASE_URL}map/`}>Map</a>
				</nav>
			</div>
			<div class="site-header-search">
				<Search
					instance="site-search"
					className="pagefind-ui"
					searchboxOptions={{ placeholder: 'Search everything…', 'show-sub-results': true }}
				/>
				<RecentSearches instance="site-search" />
			</div>
		</header>
		<main class:list={{ 'main-wide': wide }}>
			<slot />
		</main>
		<footer class="site-footer">
			<p>Personal knowledge base — answers get re-verified, not re-asked.</p>
		</footer>
	</body>
</html>
