---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const faqCount = (await getCollection('faq')).length;
const referenceCount = (await getCollection('reference')).length;
---

<Layout title="Home">
	<h1>Fallout 76 Helper</h1>
	<p>
		A personal, searchable knowledge base for Fallout 76 questions — built so
		the same question never has to be re-researched twice. Search lives in the
		header on every page, not just here.
	</p>

	<div class="tag-list">
		<a class="tag" href={`${import.meta.env.BASE_URL}faq/`}>{faqCount} FAQ answers</a>
		<a class="tag" href={`${import.meta.env.BASE_URL}reference/`}>{referenceCount} reference entries</a>
	</div>
</Layout>
