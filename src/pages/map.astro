---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Map" wide>
	<h1>Interactive map</h1>
	<p>
		Mouse wheel to zoom, drag to pan, use the search box inside the map to jump
		to a location. Map by{' '}
		<a href="https://fo76map.com/" target="_blank" rel="noopener">fo76map.com</a>,
		not hosted by this site.
	</p>

	<iframe
		class="map-frame"
		src="https://fo76map.com/"
		title="Interactive Fallout 76 map (fo76map.com)"
		loading="lazy"
	></iframe>

	<p class="meta">
		Map not loading? Open it directly:
		<a href="https://fo76map.com/" target="_blank" rel="noopener">fo76map.com ↗</a>
	</p>
</Layout>
