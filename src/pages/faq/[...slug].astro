---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('faq');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
	<h1>{entry.data.title}</h1>
	<div class="tag-list">
		{entry.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
	</div>
	<p class="meta">Verified {entry.data.verified.toDateString()}</p>

	<Content />

	{entry.data.sources.length > 0 && (
		<div class="sources">
			<strong>Sources</strong>
			<ul>
				{entry.data.sources.map((source: { label: string; url: string }) => (
					<li><a href={source.url} target="_blank" rel="noopener">{source.label}</a></li>
				))}
			</ul>
		</div>
	)}
</Layout>
